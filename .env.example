# Шаблон для локального .env (НЕ коммитится — в .gitignore).
# Реальные значения появятся после запуска ./new_channels_client.sh <slug> <bot-token>.

TELEGRAM_BOT_TOKEN=<bot-token-из-botfather>
PUBLISH_GATEWAY_SECRET=<сгенерируется скриптом>
MEMORY_GATEWAY_SECRET=<сгенерируется скриптом>
# HeyGen подключён для Иры. Значения появятся после разового создания
# аватара и (опционально) клонирования голоса, только с её явным согласием.
HEYGEN_API_KEY=<HeyGen-API-ключ>
HEYGEN_AVATAR_ID_IRINA=<появится-после-создания-аватара>
HEYGEN_VOICE_ID_IRINA=<появится-после-клонирования-голоса>
