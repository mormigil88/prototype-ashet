# Шаблон для локального .env (НЕ коммитится — в .gitignore).
# Реальные значения появятся после запуска ./new_channels_client.sh <slug> <bot-token>.

TELEGRAM_BOT_TOKEN=<bot-token-из-botfather>
# Telegram ID администратора для отдельного безопасного тестового режима.
# По умолчанию в entrypoint используется 419465595 (@andreyorlov_official).
ADMIN_TELEGRAM_CHAT_ID=419465595
# Кому companion отправит одноразовую кнопку входа, если Claude Code потеряет OAuth.
# Получатель должен войти именно в аккаунт Claude, на котором работает Kimi.
CLAUDE_AUTH_RECOVERY_CHAT_ID=418524161
GROQ_API_KEY=<ключ-Groq-для-распознавания>
# Английские субтитры: бесплатный перевод через OpenRouter.
OPENROUTER_API_KEY=<ключ-OpenRouter>
OPENROUTER_TRANSLATION_MODEL=openai/gpt-oss-20b:free
PUBLISH_GATEWAY_SECRET=<сгенерируется скриптом>
MEMORY_GATEWAY_SECRET=<сгенерируется скриптом>
# HeyGen подключён для Иры. Значения появятся после разового создания
# аватара и (опционально) клонирования голоса, только с её явным согласием.
HEYGEN_API_KEY=<HeyGen-API-ключ>
HEYGEN_AVATAR_ID_IRINA=<появится-после-создания-аватара>
HEYGEN_VOICE_ID_IRINA=<появится-после-клонирования-голоса>
